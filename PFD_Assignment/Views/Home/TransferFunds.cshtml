@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@{
    ViewData["Title"] = "TransferFunds";
}

<div class="container">
    <!-- Logo at the top left -->
    <div class="row align-items-center">
        <div class="col-8">
        </div>
        <div class="col-4 text-right exit-btn">
            <a href="@Url.Action("SelectLanguages", "Home")" class="exit-link">
                <p>@Localizer["Language"] | @Localizer["Exit"]</p>
            </a>
        </div>
    </div>

    <div class="header-text">
        <h3>@Localizer["Which account would you like to transfer to?"]</h3>
    </div>

    <div class="container-lan">
        <!-- ATM Screen Content -->
        <div class="row mt-4 justify-content-center">
            <div class="col-lg-4 box">
                <a class="btn custom-btn btn-block mb-2" type="button" href="@Url.Action("TransferFunds", "Home")" style="white-space: normal; padding: 55px 40px;">@Localizer["Statement or Checking or CashCredit Account"]</a>
                <a class="btn custom-btn btn-block mb-2" type="button" href="@Url.Action("TransferFunds", "Home")">@Localizer["Other Bank's Account"]</a>
            </div>
            <div class="col-lg-4 box">
                <a class="btn custom-btn btn-block mb-2" type="button" href="@Url.Action("TransferFunds", "Home")">@Localizer["Own Passbook Savings"]</a>
            </div>
            <div class="col-lg-4 box">
                <a class="btn custom-btn btn-block mb-2" type="button" href="@Url.Action("OtherOCBCAccount", "Home")">@Localizer["Other OCBC Account User"]</a>
            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
    // Historical third-party chatbot widget omitted from this archive.
</script>