@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@{
    ViewData["Title"] = "PasswordPIN";
}

<div class="container">
    <!-- Logo at the top left -->
    <div class="row align-items-center">
        <div class="col-8">
            <img src="~/assets/OCBC-Bank-Logo.png"
                 alt="Logo"
                 class="img-fluid logo" />
        </div>
        <div class="col-4 text-right exit-btn">
            <a href="@Url.Action("SelectLanguages", "Home")" class="exit-link">
                <p>@Localizer["Language"] | @Localizer["Exit"]</p>
            </a>
        </div>
    </div>

    <div class="header-text-passwordpin">
        <h3 style="font-weight:bold;">@Localizer["Welcome"]</h3>
        <br />
        <br />
        <h4>@Localizer["Please enter your PIN"]</h4>
    </div>   

    <div class="atm-password">
        <div class="form-group">            
            <div class="pincode-input-container d-flex justify-content-center">
                <input type="password" maxlength="1" class="form-control pincode-input" id="pin1" />
                <input type="password" maxlength="1" class="form-control pincode-input" id="pin2" />
                <input type="password" maxlength="1" class="form-control pincode-input" id="pin3" />
                <input type="password" maxlength="1" class="form-control pincode-input" id="pin4" />
                <input type="password" maxlength="1" class="form-control pincode-input" id="pin5" />
                <input type="password" maxlength="1" class="form-control pincode-input" id="pin6" />
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Function to check if the PIN is complete
        function isPinComplete() {
            const inputs = document.querySelectorAll('.pincode-input');
            return [...inputs].every(input => input.value !== '');
        }

        function sendPinToServer(pin) {
            $.ajax({
                type: 'POST',
                url: '@Url.Action("PasswordPIN", "Home")', // Replace YourController with your actual controller name
                data: { pin: pin },
                success: function (response) {
                    console.log('Request Successful');
                    // You can handle the response here
                    if (response.success) {
                        // Authentication succeeded, you can redirect or perform actions here
                        if (response.redirectUrl) {
                            window.location.href = response.redirectUrl;
                        }
                    } else {
                        // Authentication failed, handle errors here
                    }
                },
                error: function (error) {
                    console.log('Request Failed');
                    console.error("Error sending PIN to server: ", error);
                }
            });
        }

        document.addEventListener('DOMContentLoaded', (event) => {
            const inputs = document.querySelectorAll('.pincode-input');

            inputs.forEach((input, index) => {
                input.addEventListener('input', (e) => {
                    if (index < inputs.length - 1 && input.value) {
                        inputs[index + 1].focus();
                    }
                    // If the input is cleared, focus the previous one
                    else if (index !== 0 && !input.value) {
                        inputs[index - 1].focus();
                    }

                    // Check if the PIN is complete
                    if (isPinComplete()) {
                        const pin = Array.from(inputs, input => input.value).join('');
                        sendPinToServer(pin);
                    }
                });
            });
        });

        // Historical third-party chatbot widget omitted from this archive.
    </script>
}
