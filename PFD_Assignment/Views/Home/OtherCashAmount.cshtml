@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@{
    ViewData["Title"] = "OtherCashAmount";
}

<div class="container">
    <div class="row align-items-center">
        <div class="col-8">
        </div>
        <div class="col-4 text-right exit-btn">
            <a href="@Url.Action("SelectLanguages", "Home")" class="exit-link">
                <p>@Localizer["Language"] | @Localizer["Exit"]</p>
            </a>
        </div>
    </div>

    <div class="header-text" style="text-align: center; padding-top: 3.3em;">
        <h2 style="padding-top: 5em;">@Localizer["Key in the amount that you want to withdraw."]</h2>

        <!-- Bootstrap Form for Input -->
        <form method="post" asp-controller="Home" asp-action="OtherCashWithdraw">
            <div class="form-group">
                <input type="number" class="form-control" id="withdrawalAmount" name="withdrawalAmount"
                       placeholder="@Localizer["Enter amount"]" required
                       style="width: 20%; height: 50px; margin: 0 auto;">
            </div>
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="d-flex justify-content-center align-items-center" style="padding-top: 15px;">
                <button class="btn btn-lg btn-no" type="submit">@Localizer["Confirm"]</button>
            </div>
        </form>
    </div>
</div>
<script type="text/javascript">
    // Historical third-party chatbot widget omitted from this archive.
</script>