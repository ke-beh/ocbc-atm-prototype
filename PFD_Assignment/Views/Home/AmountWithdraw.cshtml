@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@{
    ViewData["Title"] = "AmountWithdraw";
    var amount = ViewContext.HttpContext.Request.Query["amount"];
}

<div class="container">
    <div class="row align-items-center">
        <div class="col-8">
        </div>
        <div class="col-4 text-right exit-btn">
            <a href="@Url.Action("SelectLanguages", "Home")" class="exit-link">
                <p>@Localizer["Language"] | @Localizer["Exit"]</p>
            </a>
        </div>
    </div>

    <div class="header-text" style="text-align: center; padding-top: 3.3em;">
        <h2 style="padding-top: 3em;">@Localizer["Are you sure you want to withdraw"] $@amount?</h2>
    </div>
    <div class="d-flex justify-content-center align-items-center">
        <div>
            <a href="@Url.Action("HomepageCashWithdraw", "Home")" class="btn btn-lg btn-yes" type="button">
                @Localizer["No"]
            </a>
            <a href="@Url.Action("ConfirmWithdrawal", "Home", new { amount = @amount })" class="btn btn-lg btn-no" type="button">
                @Localizer["Yes"]
            </a>
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="text-danger text-center">@TempData["ErrorMessage"]</div>
            }
        </div>
    </div>
</div>
<script type="text/javascript">
    // Historical third-party chatbot widget omitted from this archive.
</script>
